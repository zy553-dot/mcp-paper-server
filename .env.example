# Copy this file to .env and fill in the real values.
# .env is listed in .gitignore and is never committed.

# Crossref serves callers who identify themselves from a faster "polite pool".
# Not a secret.
CROSSREF_MAILTO=your-netid@cornell.edu

# Resend API key, used to email the bibliography. This IS a secret.
# A free Resend account can only send to the address it was registered with.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_SENDER=onboarding@resend.dev
